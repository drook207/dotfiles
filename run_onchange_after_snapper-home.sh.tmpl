#!/usr/bin/env bash
# Hourly btrfs snapshots of /home with snapper (/ is already covered by
# snap-pac before/after every package change). The timeline timer is enabled
# through packages.services in .chezmoidata/packages.toml.
# Needs sudo, so outside an interactive terminal it fails with a hint instead.
#
# Re-runs whenever the current home config differs:
# {{ output "sh" "-c" "snapper --csvout -c home get-config 2>/dev/null || true" | sha256sum }}
set -euo pipefail

command -v snapper >/dev/null || exit 0
[ "$(findmnt -no FSTYPE /home)" = btrfs ] || exit 0

settings=(
    TIMELINE_CREATE=yes
    TIMELINE_CLEANUP=yes
    TIMELINE_MIN_AGE=1800
    TIMELINE_LIMIT_HOURLY=10
    TIMELINE_LIMIT_DAILY=7
    TIMELINE_LIMIT_WEEKLY=4
    TIMELINE_LIMIT_MONTHLY=0
    TIMELINE_LIMIT_YEARLY=0
    ALLOW_USERS="$USER"
    SYNC_ACL=yes
)

# The config file is root-only; once ALLOW_USERS includes us, get-config works
# without sudo. If the config is missing (or we can't read it) it's empty.
current=$(snapper --csvout -c home get-config 2>/dev/null || true)
up_to_date=true
for s in "${settings[@]}"; do
    grep -qx "${s%%=*},${s#*=}" <<<"$current" || up_to_date=false
done
$up_to_date && exit 0

if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "snapper-home: /home snapshots not configured; run 'chezmoi apply' in a terminal" >&2
    exit 1
fi

if [ ! -f /etc/snapper/configs/home ]; then
    sudo snapper -c home create-config /home
fi
sudo snapper -c home set-config "${settings[@]}"
