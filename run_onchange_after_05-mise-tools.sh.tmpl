#!/usr/bin/env bash
# Install the tools from ~/.config/mise/config.toml (rendered by chezmoi from
# .chezmoidata). Runs after the package scripts, which install mise itself.
# No sudo needed.
# Re-runs whenever the tool list changes or a tool goes missing:
# {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }} {{ list .mise .ubuntu.mise .fedora.mise | toJson | sha256sum }}
# {{ output "sh" "-c" "command -v mise >/dev/null && mise ls --global --missing 2>/dev/null; true" | sha256sum }}
set -euo pipefail

mise=$(command -v mise || echo "$HOME/.local/bin/mise")
[ -x "$mise" ] || exit 0

"$mise" install --yes
