# Global mise tools, generated by chezmoi from .chezmoidata (mise.toml plus the
# distro's `mise` list). Add tools there, not with `mise use -g`, which would
# write here and drift from the repo.
{{- $tools := .mise.common }}
{{- if eq .chezmoi.osRelease.id "ubuntu" }}{{ $tools = concat $tools .ubuntu.mise }}{{ end }}
{{- if eq .chezmoi.osRelease.id "fedora" }}{{ $tools = concat $tools .fedora.mise }}{{ end }}
[tools]
{{- range $tools }}
{{ . | quote }} = "latest"
{{- end }}
