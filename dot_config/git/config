	name = Pascal Berndt
	email = drook207@gmail.com
	# SSH key "GitHub" in 1Password, used for signing
	signingKey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGfXzR4v21LooDWWO6JCNDmTlOUsUyvobv7HeuD8dlaR

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input
	# delta for diffs; falls back to less until git-delta is installed
	pager = "if command -v delta >/dev/null; then delta; else less; fi"

[interactive]
	diffFilter = "if command -v delta >/dev/null; then delta --color-only; else cat; fi"

# Kanagawa Paper Ink: syntax colors from the terminal palette (ansi theme),
# diff backgrounds winterRed/winterGreen like kanagawa-paper.nvim
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi
	minus-style = "syntax #43242b"
	minus-emph-style = "#c4746e bold #43242b"
	plus-style = "syntax #2b3328"
	plus-emph-style = "#699469 bold #2b3328"
	line-numbers-minus-style = "#c4746e"
	line-numbers-plus-style = "#699469"
	line-numbers-zero-style = "#727169"
	file-style = "#c4b28a bold"
	file-decoration-style = "#c4b28a ul"
	hunk-header-style = "file line-number syntax"
	hunk-header-decoration-style = "#625e5a box"

[pull]
	rebase = true

[rebase]
	autoStash = true
	stat = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictStyle = zdiff3

[status]
	showUntrackedFiles = all

# Sign commits and tags with the SSH key via 1Password (it asks to approve)
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgSign = true
[tag]
	gpgSign = true

# GitHub logins via `gh auth login` (written by `gh auth setup-git`)
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# GitLab logins via `glab auth login`
[credential "https://gitlab.com"]
	helper =
	helper = !/usr/bin/glab auth git-credential
