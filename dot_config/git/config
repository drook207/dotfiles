[user]
	name = Pascal Berndt
	email = drook207@gmail.com
	# SSH key "GitHub" in 1Password, used for signing
	signingKey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGfXzR4v21LooDWWO6JCNDmTlOUsUyvobv7HeuD8dlaR

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input

[pull]
	rebase = true

[rebase]
	autoStash = true
	stat = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictStyle = zdiff3

[status]
	showUntrackedFiles = all

# Sign commits and tags with the SSH key via 1Password (it asks to approve)
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgSign = true
[tag]
	gpgSign = true

# GitHub logins via `gh auth login` (written by `gh auth setup-git`)
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

# GitLab logins via `glab auth login`
[credential "https://gitlab.com"]
	helper =
	helper = !/usr/bin/glab auth git-credential
