#!/usr/bin/env bash
# Install the packages listed in .chezmoidata/packages.toml that are missing.
# Installing needs sudo (and paru asks to review AUR build scripts), so outside
# an interactive terminal it fails with a hint instead.
#
# Re-runs whenever the package list or the set of missing packages changes:
{{- $all := concat .packages.pacman .packages.aur }}
# {{ list $all (output "sh" "-c" (printf "command -v pacman >/dev/null && pacman -T %s || true" (join " " $all))) | toJson | sha256sum }}
set -euo pipefail

command -v pacman >/dev/null || exit 0

pacman_pkgs=({{ range .packages.pacman }}{{ . | quote }} {{ end }})
aur_pkgs=({{ range .packages.aur }}{{ . | quote }} {{ end }})

# pacman -T prints the entries that aren't satisfied (honours "provides")
mapfile -t missing_repo < <(pacman -T "${pacman_pkgs[@]}" || true)
mapfile -t missing_aur < <(pacman -T "${aur_pkgs[@]}" || true)

if [ ${#missing_repo[@]} -eq 0 ] && [ ${#missing_aur[@]} -eq 0 ]; then
    exit 0
fi

if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "install-packages: missing: ${missing_repo[*]} ${missing_aur[*]}" >&2
    echo "install-packages: run 'chezmoi apply' in a terminal to install them" >&2
    exit 1
fi

if [ ${#missing_repo[@]} -gt 0 ]; then
    sudo pacman -S --needed "${missing_repo[@]}"
fi

if [ ${#missing_aur[@]} -gt 0 ]; then
    if ! command -v paru >/dev/null; then
        # CachyOS ships paru; on plain Arch build paru-bin from the AUR
        if ! sudo pacman -S --needed paru; then
            sudo pacman -S --needed base-devel git
            tmp=$(mktemp -d)
            trap 'rm -rf "$tmp"' EXIT
            git clone https://aur.archlinux.org/paru-bin.git "$tmp/paru-bin"
            (cd "$tmp/paru-bin" && makepkg -si)
        fi
    fi
    paru -S --needed "${missing_aur[@]}"
fi
