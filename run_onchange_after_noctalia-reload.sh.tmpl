#!/usr/bin/env bash
# Reload a running noctalia when its config or palette changes, so a fresh
# `chezmoi apply` (e.g. on a new machine) takes effect without a restart.
# Re-runs whenever these change:
# config.toml {{ include "dot_config/noctalia/config.toml.tmpl" | sha256sum }}
# palette     {{ include "dot_config/noctalia/palettes/KanagawaPaperInk.json" | sha256sum }}
set -euo pipefail

command -v noctalia >/dev/null || exit 0

# Not running (e.g. applied from a TTY): it reads the new config when it starts
noctalia msg config-reload >/dev/null 2>&1 || exit 0
noctalia msg templates-apply >/dev/null 2>&1 || true
