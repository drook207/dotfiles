#!/usr/bin/env bash
# Install the packages listed in .chezmoidata/packages.toml that are missing and
# enable the listed system services.
# Installs with -Syu so a stale package database can't cause 404s from the
# mirrors (and Arch doesn't support partial upgrades).
# Installing needs sudo (and paru asks to review AUR build scripts), so outside
# an interactive terminal it fails with a hint instead.
#
# Re-runs whenever the lists, the set of missing packages or the services'
# enabled state change:
{{- $all := concat .packages.pacman .packages.aur }}
{{- $services := .packages.services.system }}
{{- $check := printf "command -v pacman >/dev/null && pacman -T %s; command -v paru %s; systemctl is-enabled %s; true" (join " " $all) (join " " (values .packages.commands | sortAlpha)) (join " " $services) }}
# {{ list $all .packages.commands $services .packages.firewall (output "sh" "-c" $check) (output "sh" "-c" "cat /etc/ufw/user.rules /etc/ufw/user6.rules 2>/dev/null; true") | toJson | sha256sum }}
set -euo pipefail

command -v pacman >/dev/null || exit 0

pacman_pkgs=({{ range .packages.pacman }}{{ . | quote }} {{ end }})
aur_pkgs=({{ range .packages.aur }}{{ . | quote }} {{ end }})
services=({{ range $services }}{{ . | quote }} {{ end }})
firewall_rules=({{ range .packages.firewall.allow }}{{ . | quote }} {{ end }})

# Packages whose command, if already on the PATH, counts as installed
declare -A provided_by_command=({{ range $pkg, $cmd := .packages.commands }}[{{ $pkg | quote }}]={{ $cmd | quote }} {{ end }})

# pacman -T prints the entries that aren't satisfied (honours "provides")
missing() {
    local pkg
    for pkg in $(pacman -T "$@" || true); do
        local cmd="${provided_by_command[$pkg]:-}"
        if [ -n "$cmd" ] && command -v "$cmd" >/dev/null; then
            continue
        fi
        echo "$pkg"
    done
}
mapfile -t missing_repo < <(missing "${pacman_pkgs[@]}")
mapfile -t missing_aur < <(missing "${aur_pkgs[@]}")
mapfile -t disabled_services < <(for s in "${services[@]}"; do systemctl is-enabled -q "$s" 2>/dev/null || echo "$s"; done)

# ufw rules missing from /etc/ufw/user.rules (only when ufw is enabled)
missing_rules=()
if systemctl is-enabled -q ufw 2>/dev/null; then
    for r in "${firewall_rules[@]}"; do
        read -r from port proto <<<"$r"
        grep -q "^### tuple ### allow $proto $port 0.0.0.0/0 any $from in" /etc/ufw/user.rules 2>/dev/null ||
            missing_rules+=("$r")
    done
fi

# The AUR helper itself
missing_helper=()
command -v paru >/dev/null || missing_helper=(paru)

if [ ${#missing_repo[@]} -eq 0 ] && [ ${#missing_aur[@]} -eq 0 ] && [ ${#disabled_services[@]} -eq 0 ] &&
    [ ${#missing_rules[@]} -eq 0 ] && [ ${#missing_helper[@]} -eq 0 ]; then
    exit 0
fi

if [ ! -t 0 ] || [ ! -t 1 ]; then
    missing_all=("${missing_helper[@]}" "${missing_repo[@]}" "${missing_aur[@]}" "${disabled_services[@]}" "${missing_rules[@]/#/ufw:}")
    echo "install-packages: missing/not enabled: ${missing_all[*]}" >&2
    echo "install-packages: run 'chezmoi apply' in a terminal to install them" >&2
    exit 1
fi

if [ ${#missing_repo[@]} -gt 0 ]; then
    sudo pacman -Syu --needed "${missing_repo[@]}"
fi

if [ ${#missing_helper[@]} -gt 0 ]; then
    # CachyOS ships paru; on plain Arch build paru-bin from the AUR
    if ! sudo pacman -Syu --needed paru; then
        sudo pacman -Syu --needed base-devel git
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        git clone https://aur.archlinux.org/paru-bin.git "$tmp/paru-bin"
        (cd "$tmp/paru-bin" && makepkg -si)
    fi
fi

if [ ${#missing_aur[@]} -gt 0 ]; then
    paru -Syu --needed "${missing_aur[@]}"
fi

if [ ${#disabled_services[@]} -gt 0 ]; then
    sudo systemctl enable --now "${disabled_services[@]}"
fi

for r in "${missing_rules[@]}"; do
    read -r from port proto <<<"$r"
    sudo ufw allow from "$from" to any port "$port" proto "$proto"
done
